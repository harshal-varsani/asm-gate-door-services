---
/**
 * PRIVACY POLICY — TEMPLATE.
 * Written around the New Zealand Privacy Act 2020 information privacy
 * principles. Have it reviewed and complete the [bracketed] details before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const updated = '[Date]';
---

<BaseLayout title="Privacy Policy" description={`How ${site.name} collects, uses and protects your personal information.`} hideActionBar>
  <article class="policy section on-light">
    <div class="wrap policy__inner">
      <header class="policy__head">
        <h1>Privacy policy</h1>
        <p class="policy__updated">Last updated: <span class="placeholder-text">{updated}</span></p>
        <p class="policy__note placeholder-text">
          [Template: review this policy, complete the bracketed details, and confirm it reflects how ASM actually handles personal information.]
        </p>
      </header>

      <div class="prose policy__body">
        <p>
          {site.name} (“we”, “us”) respects your privacy. This policy explains what personal information we collect through this website and our services, how we use it, and your rights under the New Zealand Privacy Act 2020.
        </p>

        <h2>What we collect</h2>
        <p>When you request a quote, book a repair or contact us, we may collect:</p>
        <ul>
          <li>your name, phone number and email address;</li>
          <li>the address or suburb of the job;</li>
          <li>details of your enquiry, and any photos you choose to send;</li>
          <li>basic technical information about your visit to this website, such as browser type and pages viewed.</li>
        </ul>

        <h2>How we use it</h2>
        <p>
          We use your information to respond to your enquiry, prepare quotes, carry out and follow up on work, keep service records, and meet our legal obligations. We do not sell your personal information.
        </p>

        <h2>Who we share it with</h2>
        <p>
          We only share information where needed to provide our services, for example with suppliers or contractors involved in your job, or with service providers that host this website and its forms <span
            class="placeholder-text">[e.g. Netlify, email provider]</span
          >. We require them to protect it.
        </p>

        <h2>Storage and security</h2>
        <p>
          We take reasonable steps to keep your information secure and only keep it for as long as we need it for the purposes above or as required by law. <span
            class="placeholder-text">[Add retention period.]</span
          >
        </p>

        <h2>Your rights</h2>
        <p>
          You can ask to see the personal information we hold about you and ask us to correct it. To make a request, contact us using the details below.
          If you’re not satisfied with our response, you can contact the Office of the Privacy Commissioner at privacy.org.nz.
        </p>

        <h2>Contact</h2>
        <p>
          Privacy questions: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a>.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .policy__inner {
    max-width: 52rem;
  }
  .policy__head {
    padding-bottom: var(--s-6);
    margin-bottom: var(--s-6);
    border-bottom: 1px solid var(--line-strong);
  }
  .policy__updated {
    margin-top: var(--s-4);
    color: var(--ink-soft);
  }
  .policy__note {
    margin-top: var(--s-4);
    padding: 1rem 1.1rem;
    background: var(--bone);
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .policy__body h2 {
    margin-top: 2.2em;
    font-size: var(--step-h4);
    font-stretch: 112%;
    color: var(--ink);
  }
  .policy__body ul {
    padding-left: 1.2em;
  }
  .policy__body li + li {
    margin-top: 0.4em;
  }
  .policy__body a {
    color: var(--ink);
  }
</style>
