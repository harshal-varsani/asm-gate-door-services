---
/** Thumb-reach call + quote bar on phones. Appears once the visitor scrolls. */
import Icon from './Icon.astro';
import { site } from '../config/site';
---

<div class="action-bar on-dark" data-action-bar>
  <a href={site.contact.phoneHref} class="action-bar__btn action-bar__call">
    <Icon name="phone" size={18} /> Call
  </a>
  <a href="/contact/" class="action-bar__btn action-bar__quote">
    Get a quote <Icon name="arrow" size={18} />
  </a>
</div>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 90;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 0.5rem;
    padding: 0.6rem var(--gutter) max(0.6rem, env(safe-area-inset-bottom));
    background: rgb(20 21 23 / 0.97);
    border-top: 1px solid var(--graphite);
    transform: translateY(110%);
    transition: transform var(--t-med) var(--ease-out);
  }
  .action-bar.is-visible {
    transform: translateY(0);
  }
  .action-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.125rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .action-bar__call {
    border: 1px solid var(--steel);
    color: var(--bone);
  }
  .action-bar__call :global(svg) {
    color: var(--bronze);
  }
  .action-bar__quote {
    background: var(--bronze);
    color: var(--ironsand);
  }
  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  if (bar) {
    const update = () => bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.45);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
