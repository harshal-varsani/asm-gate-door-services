---
/** FAQ accordion on native <details> — keyboard and screen-reader friendly with no JS. */
import Icon from './Icon.astro';
import type { Faq as FaqItem } from '../data/services';
import { isPlaceholder } from '../config/site';

interface Props {
  faqs: FaqItem[];
  heading?: string;
  intro?: string;
  id?: string;
}
const { faqs, heading = 'Common questions', intro, id = 'faq' } = Astro.props;
---

<section class="faq section on-light" aria-labelledby={`${id}-heading`} id={id}>
  <div class="wrap faq__grid">
    <div class="faq__head">
      <h2 id={`${id}-heading`}>{heading}</h2>
      {intro && <p class="lead">{intro}</p>}
      <a href="/contact/" class="link-arrow faq__ask">Ask us something else <Icon name="arrow" size={16} /></a>
    </div>
    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details class="faq__item" name={`${id}-group`} open={i === 0}>
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" size={20} />
              </span>
            </summary>
            <div class="faq__a">
              <p class:list={{ 'placeholder-text': isPlaceholder(f.a) }}>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 62rem) {
    .faq__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--s-9);
    }
    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
  .faq__head .lead {
    margin-top: var(--s-5);
  }
  .faq__ask {
    margin-top: var(--s-6);
  }
  .faq__list {
    border-top: 1px solid var(--line-strong);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }
  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-5);
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-h4);
    font-weight: 660;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color var(--t-fast);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    color: var(--accent-text);
  }
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: -0.2rem;
    border: 1px solid var(--line-strong);
    color: var(--accent-text);
    transition: transform var(--t-med) var(--ease-out), background-color var(--t-fast);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--bone);
  }
  .faq__a {
    padding: 0 3.5rem 1.6rem 0;
    color: var(--fg-soft);
    max-width: 62ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a {
      animation: faq-in 380ms var(--ease-out);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
