---
/** Featured projects — an asymmetric gallery of the projects marked `featured`. */
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { getProjects, toSiteImage, categoryLabels } from '../../lib/projects';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 5);
---

{
  projects.length > 0 && (
    <section class="fp section on-dark" aria-labelledby="fp-heading">
      <div class="wrap">
        <div class="section-head section-head--split">
          <h2 id="fp-heading">Doors and gates that finish the house.</h2>
          <p class="lead">A selection of the residential and commercial work in our gallery: garage doors, gates and automation.</p>
        </div>
        <ul role="list" class="fp__grid">
          {projects.map((p, i) => (
            <li class={`fp__item fp__item--${i + 1}`}>
              <a href={`/projects/#${p.id}`} class="fp__card hover-card">
                <span class="fp__img frame" data-reveal>
                  <Photo
                    image={toSiteImage(p.data.images[0], p.data.title)}
                    sizes={i === 0 ? '(min-width: 64rem) 58vw, 100vw' : '(min-width: 64rem) 40vw, 100vw'}
                    tag
                  />
                  <span class="hover-chip" aria-hidden="true">
                    View project <Icon name="arrow" size={16} />
                  </span>
                </span>
                <span class="fp__meta">
                  <span class="fp__title">{p.data.title}</span>
                  <span class="fp__cats">
                    {[p.data.sector, ...p.data.categories].map((k) => categoryLabels[k]).join(' · ')}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="fp__foot">
          <a href="/projects/" class="btn btn--ghost">
            View the project gallery <Icon name="arrow" class="icon-arrow" size={18} />
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .fp__grid {
    display: grid;
    gap: var(--s-6) var(--s-5);
    margin: 0;
  }
  .fp__card {
    display: grid;
    gap: var(--s-4);
    color: var(--bone);
    text-decoration: none;
  }
  .fp__img {
    aspect-ratio: 4 / 3;
  }
  .fp__img :global(img) {
    transition: transform 1.2s var(--ease-out);
  }
  .fp__card:hover .fp__img :global(img) {
    transform: scale(1.04);
  }
  .fp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--graphite);
  }
  .fp__title {
    font-size: var(--step-h4);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .fp__card:hover .fp__title {
    color: var(--bronze-glint);
  }
  .fp__cats {
    color: var(--ash);
    font-size: 0.8125rem;
    font-weight: 540;
    letter-spacing: 0.02em;
  }
  .fp__foot {
    margin-top: var(--s-7);
  }

  @media (min-width: 48rem) {
    .fp__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .fp__item--1 {
      grid-column: 1 / -1;
    }
    .fp__item--1 .fp__img {
      aspect-ratio: 16 / 8;
    }
    .fp__item--2,
    .fp__item--3 {
      grid-column: span 6;
    }
    .fp__item--4 {
      grid-column: span 5;
    }
    .fp__item--5 {
      grid-column: span 7;
    }
    .fp__item--4 .fp__img,
    .fp__item--5 .fp__img {
      aspect-ratio: auto;
      height: clamp(16rem, 28vw, 26rem);
    }
  }
  @media (min-width: 64rem) {
    .fp__item--1 {
      grid-column: 1 / span 7;
      grid-row: span 2;
    }
    .fp__item--1 .fp__img {
      aspect-ratio: auto;
      height: 100%;
      min-height: 30rem;
    }
    .fp__item--1 .fp__card {
      height: 100%;
      grid-template-rows: 1fr auto;
    }
    .fp__item--2,
    .fp__item--3 {
      grid-column: 8 / -1;
    }
    .fp__item--2 .fp__img,
    .fp__item--3 .fp__img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
