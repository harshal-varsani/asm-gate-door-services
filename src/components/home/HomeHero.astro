---
/**
 * Home hero — a service reel: four full-bleed, colourful photographs, one per
 * core service (gates, garage doors, automation, repairs & servicing), with
 * labelled progress tabs and a per-slide "Explore" link.
 *
 * On first load, a stack of charcoal sectional-door panels lifts off the reel
 * (the signature moment). Text is visible from the first frame.
 * Accessibility: autoplay pauses on hover/focus, has a pause button, and is
 * off entirely for prefers-reduced-motion; tabs are real buttons.
 */
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import type { ImageKey } from '../../data/images';

const slides: { image: ImageKey; label: string; caption: string; href: string; cta: string }[] = [
  {
    image: 'heroGates',
    label: 'Gates',
    caption: 'Driveway and pedestrian gates, made to suit the site and automated to suit you.',
    href: '/gates/',
    cta: 'Explore gates',
  },
  {
    image: 'heroGarage',
    label: 'Garage doors',
    caption: 'Sectional, roller, tilt and architectural doors, measured and installed properly.',
    href: '/garage-doors/',
    cta: 'Explore garage doors',
  },
  {
    image: 'heroAccess',
    label: 'Automation',
    caption: 'Openers, gate motors, keypads, intercoms and smart access, set up to work together.',
    href: '/automation-access/',
    cta: 'Explore automation',
  },
  {
    image: 'heroService',
    label: 'Repairs & servicing',
    caption: 'Fault-finding, repairs, servicing and safety checks that keep everything running.',
    href: '/repairs-maintenance/',
    cta: 'Book a repair or service',
  },
];

const trust = site.trust.filter((t) => !t.placeholder).slice(0, 4);
const panels = 6;
---

<section class="hero on-dark" aria-labelledby="hero-heading" data-reel>
  <div class="hero__slides" id="hero-reel" aria-roledescription="carousel" aria-label="Our services">
    {
      slides.map((s, i) => (
        <div
          class:list={['hero__slide frame', { 'is-active': i === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${s.label}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-slide={i}
        >
          <Photo image={s.image} sizes="100vw" priority={i === 0} quality={74} />
        </div>
      ))
    }
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__door" aria-hidden="true">
    {Array.from({ length: panels }, () => <span class="hero__panel" />)}
    <span class="hero__seal"></span>
  </div>

  <div class="wrap hero__content">
    <div class="hero__copy">
      <h1 id="hero-heading" class="hero__title">Make an <span>entrance.</span></h1>
      <p class="hero__lead">
        Garage doors, automatic gates and the systems that run them, designed, installed and serviced for homes and businesses by {site.name}.
      </p>
      <div class="hero__actions">
        <a href="/contact/" class="btn">Request a quote <Icon name="arrow" class="icon-arrow" size={18} /></a>
        <a href="#services" class="btn btn--ghost">Explore our services</a>
      </div>
      <p class="hero__call">
        Or call <a href={site.contact.phoneHref} class="tabular">{site.contact.phoneDisplay}</a>
      </p>
    </div>

    <div class="hero__reel">
      <p class="hero__caption" aria-live="polite">
        <span class="hero__caption-text" data-caption>{slides[0].caption}</span>
        <a href={slides[0].href} class="hero__caption-link" data-caption-link>
          <span data-caption-cta>{slides[0].cta}</span>
          <Icon name="arrow" size={16} />
        </a>
      </p>
      <div class="hero__controls">
        <ul role="list" class="hero__tabs">
          {
            slides.map((s, i) => (
              <li>
                <button
                  type="button"
                  class:list={['hero__tab', { 'is-active': i === 0 }]}
                  aria-controls="hero-reel"
                  aria-current={i === 0 ? 'true' : undefined}
                  aria-label={`Show ${s.label}`}
                  data-tab={i}
                  data-caption={s.caption}
                  data-href={s.href}
                  data-cta={s.cta}
                >
                  <span class="hero__tab-bar" aria-hidden="true"><span class="hero__tab-fill" data-fill /></span>
                  <span class="hero__tab-label">{s.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <button type="button" class="hero__pause" aria-label="Pause slideshow" data-reel-toggle>
          <svg class="hero__pause-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"></path></svg>
          <svg class="hero__play-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hero__trust">
    <ul role="list" class="wrap hero__trust-list">
      {
        trust.map((t) => (
          <li>
            <Icon name="check" size={16} />
            {t.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    --door-dur: 1.55s;
    --reel-ms: 6500ms;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: clamp(38rem, 100svh, 68rem);
    overflow: hidden;
    background: var(--ironsand);
  }

  /* ── Reel ─────────────────────────────────────────── */
  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: var(--ironsand);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide :global(img) {
      transform: scale(1.08);
      transition: transform 9s linear;
    }
    .hero__slide.is-active :global(img) {
      transform: scale(1);
    }
  }
  /* Scrims keep the type legible while leaving the right of the frame in full colour. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(14 15 17 / 0.92) 0%, rgb(14 15 17 / 0.55) 30%, rgb(14 15 17 / 0) 58%),
      linear-gradient(100deg, rgb(14 15 17 / 0.72) 0%, rgb(14 15 17 / 0.35) 38%, rgb(14 15 17 / 0) 62%),
      linear-gradient(to bottom, rgb(14 15 17 / 0.55), rgb(14 15 17 / 0) 22%);
  }

  /* ── The door ─────────────────────────────────────── */
  .hero__door {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    grid-template-rows: repeat(6, 1fr) 0.6rem;
    background: var(--ironsand);
    pointer-events: none;
    animation: door-lift var(--door-dur) var(--ease-door) 0.35s both;
  }
  .hero__panel {
    position: relative;
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0.07), transparent 22%, transparent 78%, rgb(0 0 0 / 0.25)),
      repeating-linear-gradient(to right, transparent 0 3px, rgb(255 255 255 / 0.014) 3px 4px),
      #1c1d20;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      inset 0 -3px 0 #060607;
  }
  .hero__panel:nth-child(odd) {
    background-color: #1a1b1e;
  }
  .hero__seal {
    background: #0b0b0c;
    box-shadow: 0 18px 40px 6px rgb(0 0 0 / 0.55);
  }
  @keyframes door-lift {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-102%);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__door {
      display: none;
    }
  }

  /* ── Content ──────────────────────────────────────── */
  .hero__content {
    align-self: end;
    display: grid;
    gap: var(--s-7);
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);
  }
  @media (min-width: 64rem) {
    .hero__content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      align-items: end;
      column-gap: var(--s-8);
    }
  }
  .hero__title {
    font-size: clamp(3.25rem, 1.5rem + 6.4vw, 6rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.038em;
    line-height: 0.9;
    max-width: 9ch;
    color: var(--bone);
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }
  .hero__title span {
    display: block;
  }
  .hero__lead {
    margin-top: var(--s-5);
    max-width: 44ch;
    color: var(--bone);
    font-size: var(--step-lead);
    line-height: 1.5;
    text-wrap: pretty;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.35);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__actions .btn--ghost {
    background: rgb(14 15 17 / 0.28);
    backdrop-filter: blur(6px);
  }
  .hero__call {
    margin-top: var(--s-5);
    color: var(--mist);
    font-size: 0.9375rem;
  }
  .hero__call a {
    color: var(--bone);
    font-weight: 650;
    text-decoration-color: var(--bronze);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * {
      animation: hero-rise 1s var(--ease-out) both;
    }
    .hero__copy > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero__copy > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .hero__copy > :nth-child(4) {
      animation-delay: 0.22s;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(14px);
    }
  }

  /* ── Reel controls ────────────────────────────────── */
  .hero__reel {
    display: grid;
    gap: var(--s-4);
    padding: 1.1rem 1.2rem 1rem;
    background: rgb(14 15 17 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-top: 2px solid var(--bronze);
    backdrop-filter: blur(10px) saturate(1.1);
  }
  .hero__caption {
    display: grid;
    gap: 0.6rem;
    max-width: 30rem;
    color: var(--mist);
    font-size: 0.9375rem;
    line-height: 1.5;
    min-height: 4.6em;
  }
  .hero__caption-text {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.4);
  }
  .hero__caption-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    color: var(--bone);
    font-size: 0.8125rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.25rem;
    background: linear-gradient(var(--bronze), var(--bronze)) 0 100% / 100% 1px no-repeat;
    transition: background-size var(--t-med) var(--ease-out);
  }
  .hero__caption-link :global(svg) {
    color: var(--bronze-hi);
    transition: transform var(--t-med) var(--ease-out);
  }
  .hero__caption-link:hover {
    background-size: 100% 2px;
  }
  .hero__caption-link:hover :global(svg) {
    transform: translateX(4px);
  }
  .hero__caption.is-changing .hero__caption-text,
  .hero__caption.is-changing .hero__caption-link {
    opacity: 0;
    transform: translateY(6px);
  }
  .hero__caption-text,
  .hero__caption-link {
    transition: opacity 0.35s ease, transform 0.35s var(--ease-out), background-size var(--t-med) var(--ease-out);
  }

  .hero__controls {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
  }
  .hero__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    flex: 1;
    margin: 0;
  }
  .hero__tab {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    padding: 0.4rem 0 0.2rem;
    background: none;
    border: 0;
    color: var(--ash);
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 106%;
    line-height: 1.25;
    transition: color var(--t-fast);
  }
  .hero__tab:hover,
  .hero__tab.is-active {
    color: var(--bone);
  }
  .hero__tab-bar {
    position: relative;
    display: block;
    height: 2px;
    background: rgb(255 255 255 / 0.28);
    overflow: hidden;
    transition: background-color var(--t-fast), height var(--t-fast);
  }
  .hero__tab:hover .hero__tab-bar {
    background: rgb(255 255 255 / 0.5);
  }
  .hero__tab-fill {
    position: absolute;
    inset: 0;
    background: var(--bronze-hi);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__tab.is-active .hero__tab-fill {
    transform: scaleX(1);
  }
  /* Autoplay: the active bar fills over the slide duration; its end advances the reel. */
  .hero.is-running .hero__tab.is-active .hero__tab-fill {
    animation: reel-progress var(--reel-ms) linear both;
  }
  .hero.is-paused .hero__tab.is-active .hero__tab-fill,
  .hero.is-running:has(.hero__reel:hover) .hero__tab.is-active .hero__tab-fill,
  .hero.is-running:focus-within .hero__tab.is-active .hero__tab-fill {
    animation-play-state: paused;
  }
  @keyframes reel-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .hero__pause {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    align-self: end;
    background: rgb(14 15 17 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius);
    color: var(--bone);
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .hero__pause:hover {
    border-color: var(--bronze-hi);
    background: rgb(14 15 17 / 0.6);
  }
  .hero__play-icon,
  .hero.is-paused .hero__pause-icon {
    display: none;
  }
  .hero.is-paused .hero__play-icon {
    display: block;
  }
  .hero.is-static .hero__pause {
    display: none;
  }
  @media (max-width: 39.99rem) {
    .hero__tab-label {
      font-size: 0.6875rem;
    }
    .hero__caption {
      min-height: 0;
    }
  }

  /* ── Trust strip: the door's bottom rail ──────────── */
  .hero__trust {
    position: relative;
    background: rgb(20 21 23 / 0.86);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .hero__trust::before {
    content: '';
    position: absolute;
    inset: -3px 0 auto;
    height: 2px;
    background: var(--groove-dark);
  }
  .hero__trust-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 0;
  }
  .hero__trust-list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 0.75rem 1rem 0;
    color: var(--mist);
    font-size: 0.8125rem;
    font-weight: 560;
    font-stretch: 106%;
    line-height: 1.3;
  }
  .hero__trust-list li :global(svg) {
    flex: none;
    color: var(--bronze);
  }
  @media (min-width: 56rem) {
    .hero__trust-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .hero__trust-list li {
      padding: 1.25rem 1rem;
      border-left: 1px solid var(--graphite);
      font-size: 0.875rem;
    }
    .hero__trust-list li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((hero) => {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'));
    const tabs = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const caption = hero.querySelector<HTMLElement>('.hero__caption')!;
    const captionText = hero.querySelector<HTMLElement>('[data-caption]')!;
    const captionLink = hero.querySelector<HTMLAnchorElement>('[data-caption-link]')!;
    const captionCta = hero.querySelector<HTMLElement>('[data-caption-cta]')!;
    const toggle = hero.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;

    const go = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === index);
        if (k === index) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      tabs.forEach((t, k) => {
        t.classList.remove('is-active');
        t.removeAttribute('aria-current');
        if (k === index) {
          void t.offsetWidth; // restart the progress animation
          t.classList.add('is-active');
          t.setAttribute('aria-current', 'true');
        }
      });
      const t = tabs[index];
      caption.classList.add('is-changing');
      window.setTimeout(() => {
        captionText.textContent = t.dataset.caption ?? '';
        captionCta.textContent = t.dataset.cta ?? '';
        captionLink.href = t.dataset.href ?? '/';
        caption.classList.remove('is-changing');
      }, 220);
    };

    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    hero.querySelectorAll<HTMLElement>('[data-fill]').forEach((fill) =>
      fill.addEventListener('animationend', () => {
        if (hero.classList.contains('is-running') && !hero.classList.contains('is-paused')) go(index + 1);
      }),
    );

    toggle.addEventListener('click', () => {
      const paused = hero.classList.toggle('is-paused');
      toggle.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
    });

    // Swipe between slides on touch screens.
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 60) go(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    // Autoplay starts once the door has lifted; never for reduced motion.
    const start = () => {
      if (reduce.matches) {
        hero.classList.add('is-static');
        hero.classList.remove('is-running');
      } else {
        hero.classList.remove('is-static');
        hero.classList.add('is-running');
      }
    };
    window.setTimeout(start, reduce.matches ? 0 : 1900);
    reduce.addEventListener('change', start);
  });
</script>
