---
/** Inner-page hero: full-bleed photo, breadcrumb, heading, lead, actions. */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { ImageKey } from '../data/images';
import { site } from '../config/site';

interface Props {
  heading: string;
  intro?: string;
  image: ImageKey;
  crumbs?: { name: string; path: string }[];
  quoteHref?: string;
  compact?: boolean;
  showActions?: boolean;
}
const { heading, intro, image, crumbs = [], quoteHref = '/contact/', compact = false, showActions = true } = Astro.props;
---

<section class:list={['page-hero on-dark', { 'page-hero--compact': compact }]}>
  <div class="page-hero__media frame">
    <Photo image={image} sizes="100vw" priority />
  </div>
  <div class="wrap page-hero__inner">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol role="list">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c, i) => (
              <li>
                {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1 class="page-hero__heading">{heading}</h1>
    {intro && <p class="page-hero__intro">{intro}</p>}
    {
      showActions && (
        <div class="page-hero__actions">
          <a href={quoteHref} class="btn">
            Request a quote <Icon name="arrow" class="icon-arrow" size={18} />
          </a>
          <a href={site.contact.phoneHref} class="btn btn--ghost">
            <Icon name="phone" size={18} /> {site.contact.phoneDisplay}
          </a>
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 78vh, 50rem);
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
    overflow: hidden;
  }
  .page-hero--compact {
    min-height: clamp(26rem, 56vh, 36rem);
  }
  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Lighter scrims: legible type bottom-left, the photograph keeps its colour. */
    background:
      linear-gradient(to top, rgb(14 15 17 / 0.9) 0%, rgb(14 15 17 / 0.5) 34%, rgb(14 15 17 / 0) 66%),
      linear-gradient(100deg, rgb(14 15 17 / 0.62) 0%, rgb(14 15 17 / 0.2) 45%, transparent 68%),
      linear-gradient(to bottom, rgb(14 15 17 / 0.5), transparent 24%);
  }
  .page-hero__media :global(img) {
    transform: scale(1.04);
    transition: transform 1.6s var(--ease-out);
  }
  .page-hero:hover .page-hero__media :global(img) {
    transform: scale(1);
  }
  .page-hero__media :global(.stock-tag) {
    z-index: 3;
  }
  .page-hero__inner {
    position: relative;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 var(--s-5);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ash);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--ash);
  }
  .crumbs a {
    color: var(--mist);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--bone);
  }
  .crumbs [aria-current] {
    color: var(--bronze-glint);
  }
  .page-hero__heading {
    max-width: 14ch;
    font-size: var(--step-display);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 0.94;
  }
  .page-hero__intro {
    margin-top: var(--s-5);
    max-width: 52ch;
    color: var(--mist);
    font-size: var(--step-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
