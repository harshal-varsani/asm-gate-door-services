---
/**
 * Layout for the "Film" design (/film/): an alternative, cinematic take on the
 * same website. It reuses the site's business details, quote form and
 * structured data, but has its own type, colour, top bar and credits.
 * It is noindexed with a canonical to the home page, so it never competes
 * with the classic pages in search.
 */
import '../styles/global.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import Logo from '../components/Logo.astro';
import { site, isPlaceholder } from '../config/site';
import { servicePages } from '../data/services';
import { businessSchema, websiteSchema, ogImageUrl } from '../lib/schema';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = Astro.site ?? Astro.url;
const canonical = new URL('/', base).toString();
const ogUrl = ogImageUrl('1719773745404-d2e57e1af9bf');
const c = site.contact;
const ph = (v: string) => (isPlaceholder(v) ? 'placeholder-text' : undefined);
const year = new Date().getFullYear();
const jsonLd = [businessSchema(base), websiteSchema(base)].filter(Boolean);
---

<!doctype html>
<html lang="en-NZ" class="fm-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0b0d1c" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, base).toString()} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
  </head>
  <body class="fm">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="fm-bar" data-fm-bar>
      <div class="fm-bar__inner">
        <a href="/film/" class="fm-bar__brand" aria-label={`${site.name}, Film design home`}><Logo /></a>
        <nav class="fm-bar__nav" aria-label="Film design sections">
          <a href="#scenes">Services</a>
          <a href="#rewind">Symptoms</a>
          <a href="#storyboard">How it works</a>
          <a href="#commentary">FAQ</a>
        </nav>
        <div class="fm-bar__end">
          <a href={c.phoneHref} class="fm-bar__call">
            <span class="fm-rec" aria-hidden="true"></span>
            <span class:list={['fm-bar__num', ph(c.phoneDisplay)]}>{c.phoneDisplay}</span>
            <span class="fm-bar__num-short">Call</span>
          </a>
          <a href="#callsheet" class="fm-btn fm-btn--sm fm-bar__quote">Get a quote</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="fm-credits">
      <div class="fm-wrap">
        <p class="fm-kicker fm-credits__kicker">Credits</p>
        <div class="fm-credits__roll">
          <a href="/film/" class="fm-credits__logo" aria-label={`${site.name}, Film design home`}><Logo /></a>
          <p class="fm-credits__line">
            Gates, garage doors and the automation that runs them, for homes and businesses across <span class={ph(site.serviceArea.primary)}>{site.serviceArea.primary}</span>.
          </p>
          <dl class="fm-credits__list">
            <div><dt>Call</dt><dd><a href={c.phoneHref} class={ph(c.phoneDisplay)}>{c.phoneDisplay}</a></dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${c.email}`} class={ph(c.email)}>{c.email}</a></dd></div>
            {c.hours.map((h) => (
              <div><dt>{h.days}</dt><dd class={ph(h.time)}>{h.time}</dd></div>
            ))}
          </dl>
          <nav aria-label="Service pages" class="fm-credits__nav">
            {servicePages.map((p) => <a href={p.path}>{p.name}</a>)}
            <a href="/projects/">Projects</a>
            <a href="/about/">About</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
        <p class="fm-credits__legal">
          © {year} {site.name} · <span class={ph(site.legalName)}>{site.legalName}</span> · The film is an illustration rendered in your browser.
        </p>
      </div>
    </footer>

    <nav class="fm-switch" aria-label="Choose a design">
      <span class="fm-switch__label">Design</span>
      <a href="/" class="fm-switch__opt">Classic</a>
      <a href="/film/" class="fm-switch__opt" aria-current="page">Film</a>
    </nav>

    <script>
      // Top bar: solid once the film has scrolled away.
      const bar = document.querySelector<HTMLElement>('[data-fm-bar]');
      const sw = document.querySelector<HTMLElement>('.fm-switch');
      let lastY = scrollY;
      const onScroll = () => {
        bar?.classList.toggle('is-solid', scrollY > innerHeight * 0.6);
        // The design switcher steps aside while reading downwards, returns on scroll up.
        const down = scrollY > lastY + 4;
        const up = scrollY < lastY - 4;
        if (down && scrollY > innerHeight * 0.5) sw?.classList.add('is-away');
        else if (up || scrollY < innerHeight * 0.5) sw?.classList.remove('is-away');
        if (down || up) lastY = scrollY;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Reveal-on-scroll for blocks marked [data-fm-reveal].
      const els = document.querySelectorAll<HTMLElement>('[data-fm-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>

<style is:global>
  /* ── Film design tokens ─────────────────────────────────────────────── */
  /* html.fm-root outranks global.css's :root, whatever order the CSS loads in. */
  html.fm-root {
    --fm-night: #0b0d1c;
    --fm-bg: #0c0c12;
    --fm-panel: #121219;
    --fm-panel-2: #181822;
    --fm-line: #262633;
    --fm-line-2: #34344a;
    --fm-fg: #f3efe6;
    --fm-soft: #b3aebd; /* 8.7:1 on --fm-bg */
    --fm-dim: #8a8597; /* labels, 5.2:1 */
    --fm-amber: #ffb866;
    --fm-amber-hi: #ffc98a;
    --fm-amber-ink: #1a1206;
    --fm-red: #ff4d3d;
    --fm-green: #63e6a1;
    --fm-serif: 'Instrument Serif', 'Times New Roman', serif;
    --fm-sans: 'DM Sans Variable', 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --fm-mono: 'DM Mono', ui-monospace, Consolas, monospace;
    --fm-radius: 1.1rem;
    --fm-gutter: clamp(1rem, 0.4rem + 2.6vw, 3rem);
    --fm-max: 78rem;
    --header-h: 4.5rem;
    /* semantic colours used by shared styles: dark by default on this page
       (the quote form's paper sheet switches back with .on-light) */
    --bg: var(--fm-bg);
    --fg: var(--fm-fg);
    --fg-soft: var(--fm-soft);
    --line: var(--fm-line);
    --line-strong: var(--fm-line-2);
    --accent-text: var(--fm-amber);
    --surface: var(--fm-panel);
    color-scheme: dark;
    /* the shared logo and quote form pick up the amber */
    --bronze: var(--fm-amber);
    --bronze-hi: var(--fm-amber-hi);
    scrollbar-color: #2a2a38 var(--fm-bg);
    accent-color: var(--fm-amber);
  }
  body.fm {
    background: var(--fm-bg);
    color: var(--fm-fg);
    font-family: var(--fm-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .fm main {
    background: var(--fm-bg);
  }
  .fm main > section::before {
    content: none !important;
  }
  .fm ::selection {
    background: var(--fm-amber);
    color: var(--fm-amber-ink);
  }
  .fm :focus-visible {
    outline: 2px solid var(--fm-amber);
    outline-offset: 3px;
  }
  .fm h1,
  .fm h2,
  .fm h3,
  .fm .fm-display {
    font-family: var(--fm-serif);
    font-weight: 400;
    font-stretch: normal;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .fm em,
  .fm .fm-accent {
    font-family: var(--fm-serif);
    font-style: italic;
    color: var(--fm-amber);
  }
  .fm .placeholder-text {
    text-decoration-color: color-mix(in srgb, var(--fm-amber) 70%, transparent);
  }
  .fm-wrap {
    width: 100%;
    max-width: calc(var(--fm-max) + var(--fm-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--fm-gutter);
  }
  .fm-sec {
    padding-block: clamp(4.5rem, 3rem + 6vw, 8.5rem);
  }
  .fm-sec--panel {
    background: var(--fm-panel);
  }
  .fm-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--fm-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fm-amber);
  }
  .fm-kicker::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: currentColor;
  }
  .fm-head {
    display: grid;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: 46rem;
  }
  .fm-head h2 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
    text-wrap: balance;
  }
  .fm-head p:not(.fm-kicker) {
    color: var(--fm-soft);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
    max-width: 40rem;
  }
  .fm-mono {
    font-family: var(--fm-mono);
    letter-spacing: 0.08em;
  }

  /* buttons: pill, amber fill or outline */
  .fm-btn {
    --pad: 1.05rem 1.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: var(--pad);
    border-radius: 999px;
    border: 1px solid var(--fm-amber);
    background: var(--fm-amber);
    color: var(--fm-amber-ink);
    font-family: var(--fm-sans);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 34px -10px color-mix(in srgb, var(--fm-amber) 65%, transparent);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      background-color 0.2s;
  }
  .fm-btn:hover {
    background: var(--fm-amber-hi);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -12px color-mix(in srgb, var(--fm-amber) 80%, transparent);
  }
  .fm-btn:active {
    transform: translateY(0);
  }
  .fm-btn--ghost {
    background: rgb(10 10 16 / 0.35);
    border-color: color-mix(in srgb, var(--fm-fg) 45%, transparent);
    color: var(--fm-fg);
    box-shadow: none;
    backdrop-filter: blur(6px);
  }
  .fm-btn--ghost:hover {
    background: rgb(243 239 230 / 0.1);
    border-color: var(--fm-fg);
    box-shadow: none;
  }
  .fm-btn--sm {
    --pad: 0.65rem 1.15rem;
    font-size: 0.9375rem;
    box-shadow: none;
  }
  .fm-btn .icon {
    width: 1.1em;
    height: 1.1em;
  }

  .fm-rec {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--fm-red);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--fm-red) 60%, transparent);
    animation: fm-rec 1.8s ease-out infinite;
    flex: none;
  }
  @keyframes fm-rec {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--fm-red) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 0.55rem transparent; }
  }

  /* reveal */
  .js [data-fm-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: var(--d, 0s);
  }
  .js [data-fm-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-rec {
      animation: none;
    }
    .js [data-fm-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .fm-btn,
    .fm-btn:hover {
      transform: none;
      transition: none;
    }
  }

  /* ── Top bar ────────────────────────────────────────────────────────── */
  .fm-bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    transition:
      background-color 0.4s,
      border-color 0.4s,
      backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }
  .fm-bar.is-solid {
    background: rgb(12 12 18 / 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    border-color: var(--fm-line);
  }
  .fm-bar__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
    max-width: calc(var(--fm-max) + var(--fm-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--fm-gutter);
  }
  .fm-bar__brand {
    color: var(--fm-fg);
    text-decoration: none;
  }
  .fm-bar__brand .logo__name,
  .fm-credits__logo .logo__name {
    font-family: var(--fm-serif);
    font-weight: 400;
    font-stretch: normal;
    font-size: 1.7rem;
    letter-spacing: 0;
  }
  .fm-bar__brand .logo__sub,
  .fm-credits__logo .logo__sub {
    font-family: var(--fm-sans);
    font-stretch: normal;
    font-weight: 500;
    letter-spacing: 0.16em;
  }
  .fm-bar__nav {
    display: none;
    gap: 1.75rem;
    margin-left: auto;
    font-size: 0.9375rem;
  }
  .fm-bar__nav a {
    color: var(--fm-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fm-bar__nav a:hover {
    color: var(--fm-fg);
  }
  .fm-bar__end {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }
  .fm-bar__call {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fm-fg);
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .fm-bar__num {
    display: none;
  }
  .fm-bar__quote {
    display: none;
  }
  @media (min-width: 40rem) {
    .fm-bar__num {
      display: inline;
    }
    .fm-bar__num-short {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .fm-bar__nav {
      display: flex;
    }
    .fm-bar__end {
      margin-left: 1rem;
    }
    .fm-bar__quote {
      display: inline-flex;
    }
  }

  /* ── Design switcher ────────────────────────────────────────────────── */
  .fm-switch {
    position: fixed;
    left: max(0.75rem, env(safe-area-inset-left));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--fm-line-2);
    border-radius: 999px;
    background: rgb(14 14 22 / 0.88);
    backdrop-filter: blur(12px);
    font-size: 0.8125rem;
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.6);
    transition:
      transform 0.45s var(--ease-out),
      opacity 0.3s;
  }
  .fm-switch.is-away:not(:focus-within) {
    transform: translateY(calc(100% + 1.5rem));
    opacity: 0;
  }
  .fm-switch__label {
    padding-inline: 0.7rem 0.35rem;
    font-family: var(--fm-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fm-dim);
  }
  .fm-switch__opt {
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    color: var(--fm-soft);
    text-decoration: none;
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .fm-switch__opt:hover {
    color: var(--fm-fg);
    background: rgb(255 255 255 / 0.06);
  }
  .fm-switch__opt[aria-current='page'] {
    background: var(--fm-amber);
    color: var(--fm-amber-ink);
  }

  /* ── Credits ────────────────────────────────────────────────────────── */
  .fm-credits {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) 6.5rem;
    border-top: 1px solid var(--fm-line);
    background: var(--fm-night);
    text-align: center;
  }
  .fm-credits__roll {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .fm-credits__logo {
    color: var(--fm-fg);
    text-decoration: none;
  }
  .fm-credits__line {
    max-width: 34rem;
    font-family: var(--fm-serif);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    line-height: 1.2;
    color: var(--fm-fg);
  }
  .fm-credits__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .fm-credits__list div {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .fm-credits__list dt {
    text-align: right;
    font-family: var(--fm-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fm-dim);
  }
  .fm-credits__list div::before {
    content: '';
    order: 1;
    width: 1.5rem;
    height: 1px;
    background: var(--fm-line-2);
    align-self: center;
  }
  .fm-credits__list dt {
    order: 0;
  }
  .fm-credits__list dd {
    order: 2;
    margin: 0;
    text-align: left;
    color: var(--fm-fg);
  }
  .fm-credits__list a {
    color: inherit;
  }
  .fm-credits__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
  }
  .fm-credits__nav a {
    color: var(--fm-soft);
    text-decoration: none;
  }
  .fm-credits__nav a:hover {
    color: var(--fm-amber);
  }
  .fm-credits__legal {
    margin-top: 3rem;
    font-family: var(--fm-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fm-dim);
  }
  .fm-credits .fm-kicker::before {
    display: none;
  }
</style>
